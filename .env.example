# Local hosting bootstrap: copy to `.env` and fill in. Never commit `.env`.
# Used by `bin/setup-cloudflare-hosting.sh` (auto-sourced when present).
# CI uses GitHub Actions secrets/vars instead.
#
# Worker name and demo.romini.party are fixed in infra/cloudflare/importIds.ts.
# PAGES_* are required by the shared edge-dns bootstrap script. Keep them
# pointed at the demo Worker so the script can sync account, zone, and token.

PULUMI_STACK=prod

# Existing active Cloudflare zone name (created/managed in edge-dns)
DOMAIN=romini.party

# Required by the bootstrap script. Not a Pages project.
PAGES_PROJECT_NAME=romini-demo
PAGES_HOSTNAMES=demo.romini.party

# Required for API calls (or provide via Bitwarden Secrets Manager)
# CLOUDFLARE_API_TOKEN=

# Optional: script can resolve these from the API token
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=

# Optional: script can mint one after `pulumi login`
# PULUMI_ACCESS_TOKEN=

# Public pages only (romini.party and demo.romini.party). Project API key.
# GitHub Actions secret POSTHOG_TOKEN. Never commit the value.
# The house box does not send these events.
# POSTHOG_TOKEN=
# POSTHOG_HOST=https://a.mzworthington.co.uk

# Optional Bitwarden Secrets Manager
# BWS_ACCESS_TOKEN=
# BWS_PROJECT_ID=
