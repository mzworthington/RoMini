{
  "name": "romini-demo",
  "main": "../../src/romini/composition/demo_worker.py",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["python_workers"],
  // Replace database_id after `npx wrangler d1 create romini-demo`.
  // Point LIBRARY_BASE_URL at the bucket's public hostname before publishing audio.
  "vars": {
    "LIBRARY_BASE_URL": "https://media.romini.party"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "romini-demo",
      "database_id": "create-with-wrangler-d1-create"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LIBRARY",
      "bucket_name": "romini-demo"
    }
  ],
  "routes": [{ "pattern": "demo.romini.party", "custom_domain": true }]
}
