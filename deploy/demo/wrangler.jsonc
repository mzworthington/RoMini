{
  "name": "romini-demo",
  "main": "../../src/romini/composition/demo_worker.py",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  // The database and bucket are imported by infra/cloudflare. This id must match that database.
  // Point LIBRARY_BASE_URL at the bucket's public hostname before publishing audio.
  "vars": {
    "LIBRARY_BASE_URL": "https://media.romini.party",
    "POSTHOG_HOST": "https://a.mzworthington.co.uk"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "romini-demo",
      "database_id": "5948544a-74ae-4e4e-922c-908af99e4b9a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LIBRARY",
      "bucket_name": "romini-demo"
    }
  ]
}
