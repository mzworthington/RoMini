{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "romini-party",
  "main": "src/index.js",
  "compatibility_date": "2026-10-24",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "containers": [
    {
      "class_name": "RominiDemo",
      "image": "../../Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DEMO",
        "class_name": "RominiDemo"
      }
    ]
  },
  "exports": {
    "RominiDemo": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "routes": [
    { "pattern": "romini.party", "custom_domain": true },
    { "pattern": "www.romini.party", "custom_domain": true },
    { "pattern": "demo.romini.party", "custom_domain": true }
  ]
}
