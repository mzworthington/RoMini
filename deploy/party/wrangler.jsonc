{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "romini-party",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./public"
  },
  "exports": {
    "RominiDemo": {
      "type": "durable-object",
      "state": "deleted"
    }
  },
  "routes": [
    { "pattern": "romini.party", "custom_domain": true },
    { "pattern": "www.romini.party", "custom_domain": true }
  ]
}
